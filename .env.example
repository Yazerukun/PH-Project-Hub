# PH PROJECT HUB — Cloudflare Worker environment

# AUTH_SECRET: 64+ char random string used to sign session tokens.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_chars

# ADMIN_EMAILS: comma-separated emails whose registration is granted the
# ADMIN role on first sign-up (owner/primary account bootstrap).
ADMIN_EMAILS=you@example.com

# OWNER_EMAILS: comma-separated emails whose registration/login is granted
# the OWNER role (highest privilege). A confirmed OWNER email is
# auto-promoted on login even if the account was created as a MEMBER.
OWNER_EMAILS=you@example.com

# Session TTL in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# Per-window rate limit cap (requests per window per client). Default 100.
RATE_LIMIT_MAX=100

# Database created by: wrangler d1 create ph-project-hub-db  (see README)
DB_ID=your-d1-database-id-here